<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>CopperIPTV</RootNamespace>
    <AssemblyName>CopperIPTV</AssemblyName>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <Authors>Copper IPTV</Authors>
    <Description>A modern, cross-platform IPTV player supporting M3U playlists and Xtream Codes.</Description>
    <!-- RuntimeIdentifier/self-contained are chosen at publish time:
         pass -r win-x64, linux-x64, osx-x64 or osx-arm64 to dotnet publish -->
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.2.1" />
    <PackageReference Include="LibVLCSharp" Version="3.9.1" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.9.1" />
    <!-- Bundled native libvlc for Windows only; Linux/macOS use the system
         libvlc (install vlc/libvlc-dev or the VLC app). Kept when no RID is
         set so plain local builds still get it on any dev OS. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21"
                      Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.Contains('win'))" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
  </ItemGroup>
</Project>
