<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CopperIPTV.ViewModels"
             x:Class="CopperIPTV.Views.LogView"
             x:DataType="vm:LogViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
            <TextBlock Text="Debug Log" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding EntryCount, StringFormat='{}{0} entries'}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ErrorCount, StringFormat='{}{0} errors'}" Foreground="#f44336" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding ErrorCount, Converter={StaticResource GreaterThanZeroConverter}}" />
            <Button Content="Clear" Command="{Binding ClearLogsCommand}" Classes="danger" Padding="12,6" FontSize="12" Margin="100,0,0,0" />
        </StackPanel>

        <!-- Log Entries -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#0d0d0d" CornerRadius="8" Padding="8">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <TextBlock Text="{Binding FormattedTime}" FontSize="11" FontFamily="Consolas" Width="85" Foreground="#666666" />
                            <Border Background="{Binding Level, Converter={StaticResource LogLevelToBgColorConverter}}" Width="50" Height="18" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Level, Converter={StaticResource LogLevelToTextConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}" />
                            </Border>
                            <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#888888" Width="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Message}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
