<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CopperIPTV.ViewModels"
             xmlns:vlc="using:LibVLCSharp.Avalonia"
             x:Class="CopperIPTV.Views.PlayerView"
             x:DataType="vm:PlayerViewModel"
             Padding="0">

    <vlc:VideoView x:Name="VideoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid x:Name="ControlsOverlay" PointerExited="OnPointerExited">

            <!-- Transparent hit-test layer captures pointer events over video -->
            <Border Background="Transparent"
                    PointerMoved="OnPointerMoved"
                    PointerEntered="OnPointerEntered" />

            <!-- All hoverable UI wrapped in single container (hidden by default) -->
            <Border x:Name="UIControlsContainer" IsVisible="False"
                    PointerMoved="OnPointerMoved"
                    PointerEntered="OnPointerEntered">
                <Panel>

                    <!-- Header Bar (top-left) -->
                    <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" Spacing="12" Margin="16,12,0,0"
                                VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Button Content="← Back" Command="{Binding GoBackCommand}" Padding="12,6" CornerRadius="6"
                                Background="#cc000000" Foreground="#ffffff" BorderThickness="0" FontSize="13" />
                        <TextBlock Text="{Binding ChannelName}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#ffffff" VerticalAlignment="Center" MaxWidth="300"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Command="{Binding ToggleFavoriteCommand}" Padding="10,6" CornerRadius="6"
                                Background="#cc000000" Foreground="#ffffff" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="FavIcon" Text="♡" FontSize="14" />
                                <TextBlock x:Name="FavText" Text="Favorite" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="HeaderEpgTitle" Text="{Binding CurrentEpgTitle}" FontSize="12"
                                   Foreground="#cccccc" VerticalAlignment="Center"
                                   IsVisible="{Binding CurrentEpgTitle, Converter={StaticResource NotEmptyStringConverter}}" />
                    </StackPanel>

                    <!-- Quality Badge (top-right) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,12"
                            Background="#cc000000" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="QualityDot" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StreamQualityText}" FontSize="11"
                                       Foreground="#ffffff" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Channel Navigation (sides) -->
                    <Button x:Name="PrevChannelBtn" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="#60000000" Foreground="#ffffff" BorderThickness="0" CornerRadius="0"
                            Width="50" Height="100" Command="{Binding PreviousChannelCommand}"
                            Content="◀" FontSize="20"
                            IsVisible="{Binding HasPreviousChannel}" Margin="8,0,0,0" />
                    <Button x:Name="NextChannelBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#60000000" Foreground="#ffffff" BorderThickness="0" CornerRadius="0"
                            Width="50" Height="100" Command="{Binding NextChannelCommand}"
                            Content="▶" FontSize="20"
                            IsVisible="{Binding HasNextChannel}" Margin="0,0,8,0" />

                    <!-- Bottom Control Bar -->
                    <Border x:Name="ControlsBar" VerticalAlignment="Bottom" Background="#cc000000">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,8,12,8">

                            <!-- Left controls -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="PlayPauseButton" Content="▶" Padding="8,4" CornerRadius="4"
                                        Background="Transparent" Foreground="#ffffff" BorderThickness="0"
                                        FontSize="16" Click="OnPlayPauseClicked" />
                                <Button Content="⏮" Padding="6,4" CornerRadius="4"
                                        Background="Transparent" Foreground="#ffffff" BorderThickness="0"
                                        FontSize="14" Command="{Binding PreviousChannelCommand}"
                                        IsVisible="{Binding HasPreviousChannel}" />
                                <Button Content="⏭" Padding="6,4" CornerRadius="4"
                                        Background="Transparent" Foreground="#ffffff" BorderThickness="0"
                                        FontSize="14" Command="{Binding NextChannelCommand}"
                                        IsVisible="{Binding HasNextChannel}" />
                                <Button x:Name="MuteButton" Content="🔊" Padding="6,4" CornerRadius="4"
                                        Background="Transparent" Foreground="#ffffff" BorderThickness="0"
                                        FontSize="14" Click="OnMuteClicked" />
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80"
                                        Width="80" VerticalAlignment="Center" />
                                <TextBlock x:Name="VolumeLabel" Text="80%" FontSize="11"
                                           Foreground="#cccccc" VerticalAlignment="Center" MinWidth="32" />
                            </StackPanel>

                            <!-- Center: seek bar -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        Margin="16,0">
                                <TextBlock x:Name="CurrentTimeText" Text="00:00" FontSize="11"
                                           Foreground="#cccccc" VerticalAlignment="Center" />
                                <Slider x:Name="SeekSlider" Minimum="0" Maximum="100" Value="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                <TextBlock x:Name="TotalTimeText" Text="LIVE" FontSize="11"
                                           Foreground="#cccccc" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Right controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:Name="MinimizeBtn" Content="─" Padding="8,4" CornerRadius="4"
                                        Background="Transparent" Foreground="#ffffff" BorderThickness="0"
                                        FontSize="16" Click="OnMinimizeClicked" />
                                <Button x:Name="MaximizeBtn" Content="⛶" Padding="8,4" CornerRadius="4"
                                        Background="Transparent" Foreground="#ffffff" BorderThickness="0"
                                        FontSize="16" Click="OnMaximizeClicked" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Panel>
            </Border>

            <!-- Center Play/Pause flash -->
            <Button x:Name="CenterPlayPauseBtn" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#80000000" Foreground="#ffffff" BorderThickness="0" CornerRadius="50"
                    Width="70" Height="70" FontSize="28" Content="▶"
                    Click="OnCenterPlayPauseClicked" IsVisible="False" />

            <!-- Loading Overlay -->
            <Border x:Name="LoadingOverlay" Background="#cc000000" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" IsVisible="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <ProgressBar IsIndeterminate="True" Width="200" Foreground="#b87333" />
                    <TextBlock x:Name="StatusText" Text="Loading stream..." FontSize="14"
                               Foreground="#ffffff" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Error Overlay -->
            <Border x:Name="ErrorOverlay" Background="#cc000000" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" IsVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <TextBlock Text="Stream Error" FontSize="20" FontWeight="SemiBold"
                               Foreground="#f44336" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ErrorText" Text="Failed to load stream" FontSize="14"
                               Foreground="#cccccc" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="RetryButton" Content="Retry" Width="120" Padding="12,8" CornerRadius="6"
                                Background="#b87333" Foreground="#ffffff" BorderThickness="0" FontWeight="Medium" />
                        <Button Content="Back" Command="{Binding GoBackCommand}" Width="120" Padding="12,8"
                                CornerRadius="6" Background="#444444" Foreground="#ffffff" BorderThickness="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </vlc:VideoView>
</UserControl>
