<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CopperIPTV.ViewModels"
             xmlns:m="using:CopperIPTV.Models"
             xmlns:controls="using:CopperIPTV.Controls"
             x:Class="CopperIPTV.Views.FavoritesView"
             x:DataType="vm:FavoritesViewModel"
             Padding="24">

    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="Favorites" FontSize="28" FontWeight="Bold" />
                <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Padding="12,8" />
            </StackPanel>
            <TextBox Text="{Binding SearchQuery}" Watermark="Search favorites..." />
        </StackPanel>

        <TextBlock Grid.Row="1" Classes="subtitle" Margin="0,0,0,24"
                   Text="{Binding FavoriteChannels.Count, StringFormat='{}{0} favorite channels'}" />

        <Grid Grid.Row="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                        IsVisible="{Binding !HasFavorites}">
                <TextBlock Text="❤️" FontSize="64" HorizontalAlignment="Center" />
                <TextBlock Text="No Favorites Yet" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Heart your favorite channels to find them here" Classes="subtitle" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasFavorites}">
                <ItemsControl ItemsSource="{Binding FavoriteChannels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:Channel">
                            <Button Margin="10" Padding="0" Background="Transparent" BorderThickness="0"
                                    Click="OnChannelClick" Width="220">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" Click="OnMenuOpenClick" />
                                        <MenuItem Header="Remove from Favorites" Click="OnMenuToggleFavoriteClick" />
                                        <Separator />
                                        <MenuItem Header="Delete Channel" Click="OnMenuDeleteClick" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Border Classes="card" Width="200">
                                    <StackPanel>
                                        <Border Height="113" Background="#1a1a1a" CornerRadius="12,12,0,0">
                                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image x:Name="FavChLogo" controls:AsyncImageLoader.Source="{Binding Logo}" MaxWidth="120" MaxHeight="80" Stretch="Uniform"
                                                       IsVisible="{Binding Logo, Converter={StaticResource NotEmptyStringConverter}}" />
                                                <Border x:Name="FavChPlaceholder" Width="60" Height="60" CornerRadius="30" Background="#c4781a"
                                                        IsVisible="{Binding Logo, Converter={StaticResource EmptyStringConverter}}">
                                                    <TextBlock FontSize="28" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Text="{Binding Name, Converter={StaticResource FirstCharConverter}}"
                                                               Foreground="#ffffff" />
                                                </Border>
                                            </Panel>
                                        </Border>
                                        <StackPanel Margin="12">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Group}" Classes="muted" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
